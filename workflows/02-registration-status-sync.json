    {
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r && r.company_id);\nconst esc = s => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;');\nconst body = rows.map(r => '<tr><td>' + esc(r.company_name) + '<br><small>' + esc(r.company_id) + '</small></td><td>' + esc(r.company_status) + '</td><td>' + esc(r.deadline) + '</td><td>' + r.eligible + '</td><td>' + r.student_confirmed + '</td><td>' + r.declined + '</td><td>' + r.pending + '</td><td>' + r.needs_review + '</td><td>' + esc(r.confirmation_rate) + '</td><td>' + esc(r.by_department) + '</td><td><a href=\"' + esc(r.spreadsheet_url) + '\">Sheet</a></td></tr>').join('');\nconst html = '<p>Company-wise registration report (' + $now.setZone('Asia/Kolkata').toFormat('dd LLL yyyy') + ')</p>'\n  + '<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\"><tr><th>Company</th><th>Status</th><th>Deadline</th><th>Eligible</th><th>Confirmed</th><th>Declined</th><th>Pending</th><th>Needs review</th><th>Rate</th><th>By dept (confirmed/total)</th><th>Link</th></tr>' + body + '</table>'\n  + '<p><i>Confirmed = student confirmed via the placement form. Verify actual registrations with the company where required.</i></p>';\nreturn [{ json: { company_count: rows.length, html } }];"
      },
      "id": "8eb38c71-0ec2-4d38-8511-dccc0bb8b0c4",
