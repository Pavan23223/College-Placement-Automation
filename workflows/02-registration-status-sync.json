      "name": "Read Registration Status",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        944,
        512
      ],
      "executeOnce": true,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst co = $('Current Company').first().json;\n\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r && r.email_key && r.company_id === co.company_id);\n\nconst count = s => rows.filter(\n  r => String(r.status || '').trim() === s\n).length;\n\nconst confirmed = count('Registered');\n\nconst depts = {};\n\nfor (const r of rows) {\n  const d = String(r.department || 'NA').toUpperCase();\n\n  if (!depts[d]) {\n    depts[d] = { total: 0, confirmed: 0 };\n  }\n\n  depts[d].total++;\n\n  if (String(r.status || '').trim() === 'Registered') {\n    depts[d].confirmed++;\n  }\n}\n\nreturn [{\n  json: {\n    report_time: $now.setZone('Asia/Kolkata').toFormat('yyyy-MM-dd HH:mm'),\n    company_id: co.company_id,\n    company_name: co.company_name,\n    job_role: co.job_role,\n    deadline: String(co.deadline).slice(0, 10),\n    company_status: co.status,\n\n    eligible: rows.length,\n    student_confirmed: confirmed,\n    declined: count('Declined'),\n    pending: count('Pending'),\n    needs_review: count('Needs Review'),\n\n    confirmation_rate: rows.length\n      ? (confirmed / rows.length * 100).toFixed(1) + '%'\n      : '0%',\n\n    by_department: Object.keys(depts)\n      .sort()\n      .map(d => d + ': ' + depts[d].confirmed + '/' + depts[d].total)\n      .join('; '),\n\n    spreadsheet_url: co.spreadsheet_url,\n\n    note: 'Confirmations are student self-reports, not verified company registrations'\n  }\n}];\n"
      },
