      "id": "f8fc5ff3-1538-4165-af64-6e3e01727848",
      "name": "Get Sent Reminders",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1408,
        320
      ],
      "executeOnce": true,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const co = $('Current Company').first().json;\nconst today = $now.setZone('Asia/Kolkata').toISODate();\nconst rows = $('Read Registration Status').all().map(i => i.json).filter(r => r && r.email_key && r.company_id === co.company_id);\nconst sentKeys = new Set($input.all().map(i => i.json.email_key).filter(Boolean));\nconst deadline = String(co.deadline).slice(0, 10);\nconst daysLeft = Math.max(0, Math.round(DateTime.fromISO(deadline).diff(DateTime.fromISO(today), 'days').days));\nconst out = [];\nfor (const r of rows) {\n  if (String(r.status).trim() !== 'Pending') continue;\n  const usn = String(r.usn).trim().toUpperCase();\n  const key = co.company_id + '|' + usn + '|Reminder|' + today;\n  if (sentKeys.has(key)) continue;\n  out.push({ json: {\n    reminder_key: key, email_key: r.email_key, company_id: co.company_id, usn, name: r.name, email: r.email,\n    reminders_sent: (parseInt(r.reminders_sent, 10) || 0) + 1, last_reminder_on: today, days_left: daysLeft\n  } });\n}\nreturn out.length ? out : [{ json: { _noop: true, company_id: co.company_id } }];"
      },
