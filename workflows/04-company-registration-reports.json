    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Reminder: {{ $(\"Current Company\").first().json.company_name }} registration closes {{ $(\"Current Company\").first().json.deadline }}",
        "message": "=<p>Dear {{ $json.name }} ({{ $json.usn }}),</p><p>We have not yet received your confirmation for the <b>{{ $(\"Current Company\").first().json.company_name }}</b> - {{ $(\"Current Company\").first().json.job_role }} drive. {{ $json.days_left === 0 ? \"Today is the last day.\" : $json.days_left + \" day(s) left.\" }}</p><p><b>Step 1 - Register on the company portal:</b> <a href=\"{{ $(\"Current Company\").first().json.registration_url }}\">{{ $(\"Current Company\").first().json.registration_url }}</a><br><b>Step 2 - Confirm with the placement cell:</b> <a href=\"{{ $(\"Current Company\").first().json.form_url }}\">{{ $(\"Current Company\").first().json.form_url }}</a></p><p>Deadline: {{ $(\"Current Company\").first().json.deadline }}. If you are not interested, choose \"No\" in the form and you will not get further reminders.</p><p>Regards,<br>Training &amp; Placement Cell</p>",
        "options": {
          "appendAttribution": false
        }
      },
