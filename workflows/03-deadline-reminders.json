    {
      "parameters": {
        "jsCode": "const company = $(\"Current Company\").first().json;\nconst responses = $(\"Get Form Responses\").first().json.responses || [];\n\nfunction getAnswer(response, questionId) {\n  return response.answers?.[questionId]?.textAnswers?.answers?.[0]?.value || \"\";\n}\n\nreturn $input.all().map(item => {\n  const student = item.json;\n\n  const response = responses.find(r =>\n    getAnswer(r, company.q_usn).trim().toUpperCase() ===\n    String(student.usn).trim().toUpperCase()\n  );\n\n  if (!response) {\n    return { json: student };\n  }\n\n  const confirmation = getAnswer(response, company.q_confirm);\n  const registered = confirmation.startsWith(\"Yes\");\n\n  return {\n    json: {\n      ...student,\n      status: registered ? \"Registered\" : \"Declined\",\n      student_confirmation: confirmation,\n      confirmed_at: registered ? new Date().toISOString() : \"\",\n      response_id: response.responseId || \"\",\n      last_updated: new Date().toISOString()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1616,
        160
      ],
      "id": "3b8b2b96-bd7a-44b5-8ae6-caef213fe42c",
      "name": "Code in JavaScript"
    }
